# 复制为 .env 后按需修改
APP_ENV=dev
LOG_LEVEL=INFO
LOG_JSON=false

# 与 docker-compose.yml 对应
DATABASE_URL=postgresql+asyncpg://agentgate:agentgate@localhost:5432/agentgate
REDIS_URL=redis://localhost:6379/0

# Provider：二选一。
# Anthropic 原生（v1/messages, x-api-key）：
ANTHROPIC_API_KEY=
# OpenAI 兼容端点（chat/completions, Bearer），如 DeepSeek 代理：
OPENAI_BASE_URL=
OPENAI_API_KEY=

# 默认模型（对话主模型）
DEFAULT_MODEL=claude-opus-4-8
# 全量摘要压缩用的低成本模型（阶段 3）。留空则复用 DEFAULT_MODEL。
SUMMARY_MODEL=
# 过载时的模型降级链（逗号分隔，按序尝试）。留空则无降级。
FALLBACK_MODELS=

# —— 认证/限流（阶段 4）——
# 是否强制认证。dev 默认 false 匿名放行；生产必须 true。
AUTH_REQUIRED=false
# API Key 哈希盐（服务端机密，不入库）。生产必须改掉。
AUTH_SALT=dev-insecure-salt-change-me

# 允许跨域的前端来源（逗号分隔）
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
