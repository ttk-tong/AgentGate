# 复制为 .env 后按需修改
APP_ENV=dev
LOG_LEVEL=INFO
LOG_JSON=false

# 与 docker-compose.yml 对应
DATABASE_URL=postgresql+asyncpg://agentgate:agentgate@localhost:5432/agentgate
REDIS_URL=redis://localhost:6379/0

# Provider：二选一。
# Anthropic 原生（v1/messages, x-api-key）：
ANTHROPIC_API_KEY=
# OpenAI 兼容端点（chat/completions, Bearer），如 DeepSeek 代理：
OPENAI_BASE_URL=
OPENAI_API_KEY=

# 默认模型（对话主模型）。注意这里填的是**当前 provider 的模型 id**：
# 走 Anthropic 就填 claude-*，走 OpenAI 兼容端点就填该端点的 id（如 deepseek-chat）。
DEFAULT_MODEL=claude-opus-5
# 全量摘要压缩用的低成本模型（阶段 3）。留空则复用 DEFAULT_MODEL。
SUMMARY_MODEL=
# 过载时的模型降级链（逗号分隔，按序尝试）。留空则无降级。
FALLBACK_MODELS=

# —— 认证/限流（阶段 4）——
# 是否强制认证。dev 默认 false 匿名放行；生产必须 true。
AUTH_REQUIRED=false
# API Key 哈希盐（服务端机密，不入库）。生产必须改掉。
AUTH_SALT=dev-insecure-salt-change-me

# 允许跨域的前端来源（逗号分隔）
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# —— MCP 外部工具接入（可选，见 app/mcp）——
# 一段 JSON 数组，留空则整个 MCP 子系统不启用。必须写成一行。
# readonly_tools 是唯一能让 MCP 工具并发执行的开关——并发跑第三方写操作的
# 后果由部署方承担，所以只认这份名单，不采信 server 自报的 readOnlyHint。
# startup_timeout_s 给握手用（npx/uvx 首次要下载包，冷启动几十秒很正常）。
# MCP_SERVERS=[{"name":"fs","transport":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/data"],"readonly_tools":["read_text_file","list_directory"],"startup_timeout_s":120}]
#
# 不配也能验证接入是否正常（起一台内置的 demo server，无需 Node/网络）：
#   .venv/Scripts/python.exe -m scripts.mcp_smoke
